ENVIRONMENT=development
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=signtrans

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

MAX_UPLOAD_MB=5
MAX_VIDEO_UPLOAD_MB=100

MODELS_DIR=ml/models
DATASET_ROOT=ml/datasets/processed
DATASET_REPORT=ml/models/dataset_report.json

WS_RATE_LIMIT=12
WS_RATE_WINDOW_SECONDS=1
PREDICTION_TTL_SECONDS=300
PREDICTION_CACHE_SIZE=1000

ISL40_ROOT=ml/datasets/ISL40
ISL40_CACHE=ml/datasets/ISL40/.cache/landmarks
